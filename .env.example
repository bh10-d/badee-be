# ==============================================================================
# Print Farm Backend (NestJS + PostgreSQL + MediaMTX) — Standalone Repo Config
# All ports >= 6000
# ==============================================================================

# NestJS API Server
API_PORT=6001
API_HOST=127.0.0.1
CORS_ORIGIN=http://127.0.0.1:6100,http://localhost:6100,http://127.0.0.1:6002,http://localhost:6002

# PostgreSQL (Docker Compose + Prisma)
POSTGRES_USER=printfarm
POSTGRES_PASSWORD=printfarm_dev_secret
POSTGRES_DB=printfarm
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=6432
DATABASE_URL="postgresql://printfarm:printfarm_dev_secret@127.0.0.1:6432/printfarm?schema=public"

# MediaMTX (Camera WebRTC / HLS gateway)
MEDIAMTX_BIND=127.0.0.1
MEDIAMTX_HLS_PORT=6888
MEDIAMTX_WEBRTC_PORT=6889
MEDIAMTX_API_PORT=6997
MEDIAMTX_API_URL=http://127.0.0.1:6997
MEDIAMTX_WEBRTC_URL=http://127.0.0.1:6889

# AES-256-GCM key (64 hex chars = 32 bytes) for encrypting printer credentials in DB
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Auth / JWT (Phase 3 — change in production!)
JWT_SECRET="change_this_to_a_long_random_secret_at_least_32_chars_long"
JWT_TTL_SEC=86400
ADMIN_EMAIL="admin@printfarm.local"
ADMIN_PASSWORD="ChangeMeAdmin123!"

# Storage & Telemetry
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=150
WS_BROADCAST_INTERVAL_MS=500
